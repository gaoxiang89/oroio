{
  "name": "oroio-desktop",
  "version": "1.0.1",
  "description": "oroio Desktop - Factory Droid API Key Manager",
  "main": "dist/main/index.js",
  "author": "gaoxiang89",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaoxiang89/oroio.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"sleep 2 && USE_DEV_SERVER=true electron .\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "cd ../web && npm run dev",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "cd ../web && npm run build",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "menubar": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "concurrently": "^9.1.2",
    "electron": "^33.4.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.3"
  }
}
